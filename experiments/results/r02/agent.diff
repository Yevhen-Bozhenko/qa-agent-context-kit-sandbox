diff --git a/tests/api/bookings/create-booking-validation.spec.ts b/tests/api/bookings/create-booking-validation.spec.ts
new file mode 100644
index 0000000..618916a
--- /dev/null
+++ b/tests/api/bookings/create-booking-validation.spec.ts
@@ -0,0 +1,92 @@
+import { test, expect } from '../../../src/fixtures';
+import { aBooking, type BookingBuilder } from '../../../src/data/bookings/BookingBuilder';
+import type { Booking, ErrorResponse } from '../../../src/models';
+import { daysFromToday } from '../../../src/utils/dates';
+
+type InvalidCase = { name: string; patch: (b: BookingBuilder) => BookingBuilder; fields: string[] };
+
+// Same calendar day as the builder's default checkIn, so only the format is wrong
+// and checkOut (3 days later) still comes after it.
+const defaultCheckIn = daysFromToday(30);
+const [year, month, day] = defaultCheckIn.split('-');
+
+// Rules: BOOK-412 — checkIn/checkOut required YYYY-MM-DD dates, checkOut after checkIn;
+// guests required integer 1–8.
+const invalidCases: InvalidCase[] = [
+  { name: 'checkIn is missing', patch: (b) => b.withoutCheckIn(), fields: ['checkIn'] },
+  {
+    name: 'checkIn is DD-MM-YYYY',
+    patch: (b) => b.withCheckIn(`${day}-${month}-${year}`),
+    fields: ['checkIn'],
+  },
+  {
+    name: 'checkIn uses slashes',
+    patch: (b) => b.withCheckIn(`${year}/${month}/${day}`),
+    fields: ['checkIn'],
+  },
+  { name: 'checkOut is missing', patch: (b) => b.withoutCheckOut(), fields: ['checkOut'] },
+  {
+    name: 'checkOut is not a date',
+    patch: (b) => b.withCheckOut('not-a-date'),
+    fields: ['checkOut'],
+  },
+  {
+    name: 'checkOut is on the check-in day',
+    patch: (b) => b.checkOutDaysAfterCheckIn(0),
+    fields: ['checkOut'],
+  },
+  {
+    name: 'checkOut is before checkIn',
+    patch: (b) => b.checkOutDaysAfterCheckIn(-1),
+    fields: ['checkOut'],
+  },
+  { name: 'guests is missing', patch: (b) => b.withoutGuests(), fields: ['guests'] },
+  { name: 'guests is 0', patch: (b) => b.withGuests(0), fields: ['guests'] },
+  { name: 'guests is 9', patch: (b) => b.withGuests(9), fields: ['guests'] },
+  { name: 'guests is negative', patch: (b) => b.withGuests(-1), fields: ['guests'] },
+  { name: 'guests is not an integer', patch: (b) => b.withGuests(2.5), fields: ['guests'] },
+  {
+    name: 'every field is missing',
+    patch: (b) => b.withoutCheckIn().withoutCheckOut().withoutGuests(),
+    fields: ['checkIn', 'checkOut', 'guests'],
+  },
+  {
+    name: 'checkOut is on the check-in day and guests is 9',
+    patch: (b) => b.checkOutDaysAfterCheckIn(0).withGuests(9),
+    fields: ['checkOut', 'guests'],
+  },
+];
+
+test.describe(
+  'POST /bookings validation',
+  { tag: ['@api', '@regression'], annotation: { type: 'issue', description: 'BOOK-412' } },
+  () => {
+    for (const c of invalidCases) {
+      test(`rejects booking when ${c.name}`, async ({ bookingsClient }) => {
+        const response = await bookingsClient.create(c.patch(aBooking()).build());
+
+        expect(response.status()).toBe(400);
+        const body = (await response.json()) as ErrorResponse;
+        expect(body.code).toBe('VALIDATION_ERROR');
+        // The ticket doesn't fix the order of errors, only that there is one per invalid field.
+        expect(body.errors.map((e) => e.field).sort()).toEqual([...c.fields].sort());
+      });
+    }
+
+    const validBoundaries: { name: string; patch: (b: BookingBuilder) => BookingBuilder }[] = [
+      { name: '1 guest', patch: (b) => b.withGuests(1) },
+      { name: '8 guests', patch: (b) => b.withGuests(8) },
+      { name: 'checkOut one day after checkIn', patch: (b) => b.checkOutDaysAfterCheckIn(1) },
+    ];
+
+    for (const c of validBoundaries) {
+      test(`accepts booking with ${c.name}`, async ({ bookingsClient }) => {
+        const response = await bookingsClient.create(c.patch(aBooking()).build());
+
+        expect(response.status()).toBe(201);
+        const booking = (await response.json()) as Booking;
+        await bookingsClient.delete(booking.id);
+      });
+    }
+  },
+);
